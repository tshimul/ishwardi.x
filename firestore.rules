rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admin_users/$(request.auth.uid))
      );
    }

    function isValidProvider(data) {
      return data.name is string && data.name.size() > 0 &&
             data.primaryCategory is string && data.primaryCategory.size() > 0 &&
             data.contactNumber is string && data.contactNumber.size() > 0 &&
             data.locationArea is string && data.locationArea.size() > 0 &&
             data.isVerified is bool &&
             data.isActive is bool;
    }

    // Providers Collection: Public read-only, Admin writes only
    match /providers/{providerId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidProvider(request.resource.data);
      allow delete: if isAdmin();
    }

    // Categories Collection: Public read-only, Admin writes only
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Location Areas Collection: Public read-only, Admin writes only
    match /location_areas/{areaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin Users Collection: Restricted to authenticated admins only
    match /admin_users/{userId} {
      allow read, write: if isAdmin();
    }
  }
}
